{
  "name": "katatay-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "pack:katatay": "node packaging/pack.mjs",
    "typecheck": "tsc --noEmit",
    "boundaries": "depcruise --output-type err-long .",
    "secrets": "gitleaks dir . --config .gitleaks.toml --exit-code 2 --redact --verbose --no-banner",
    "test": "npm run --silent test:run:fast; fast=$?; npm run --silent test:run:slow; slow=$?; exit $((fast || slow))",
    "test:run:fast": "JUNIT_REPORT=reports/junit/fast.xml vitest run --project='fast*' --coverage --reporter=default --reporter=./src/adapters/typescript/vitest-junit-reporter.ts",
    "test:run:slow": "JUNIT_REPORT=reports/junit/slow.xml vitest run --project='slow*' --passWithNoTests --reporter=default --reporter=./src/adapters/typescript/vitest-junit-reporter.ts",
    "test:fast": "vitest run --project='fast*'",
    "workflow:version": "node src/workflow/cli/workflow.mjs version",
    "verify": "node src/workflow/cli/workflow.mjs verify",
    "req:lint": "node src/workflow/cli/workflow.mjs req lint",
    "req:guard": "node src/workflow/cli/workflow.mjs req guard",
    "req:trace": "node src/workflow/cli/workflow.mjs req trace",
    "req:risk": "node src/workflow/cli/workflow.mjs req risk",
    "req:renumber": "node src/workflow/cli/workflow.mjs req renumber",
    "triage": "node src/workflow/cli/workflow.mjs triage",
    "replan": "node src/workflow/cli/workflow.mjs replan",
    "state:show": "node src/workflow/cli/workflow.mjs state show",
    "state:verify": "node src/workflow/cli/workflow.mjs state verify",
    "review:areas": "node src/workflow/cli/workflow.mjs areas",
    "coverage:check": "node src/workflow/cli/workflow.mjs coverage",
    "mutate": "node src/workflow/cli/workflow.mjs mutate",
    "checks-analysis": "node src/workflow/cli/workflow.mjs checks-analysis",
    "report": "node src/workflow/cli/workflow.mjs report",
    "agent:defaults": "node src/workflow/cli/workflow.mjs defaults node src/agents/claude/defaults.mjs",
    "workflow-init": "node src/agents/init.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@swc/core": "^1.16.18",
    "@types/node": "^22.20.4",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.6.0",
    "gray-matter": "^4.0.3",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
