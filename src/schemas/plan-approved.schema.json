{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan-approved.schema.json",
  "title": "Written plan_approved event, version 1",
  "type": "object",
  "properties": {
    "version": {"const": 1},
    "seq": {"type": "integer", "minimum": 1, "maximum": 9999},
    "ts": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"},
    "prev": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
    "branch": {"type": "string", "pattern": "\\S"},
    "event": {"const": "plan_approved"},
    "payload": {
      "type": "object",
      "properties": {
        "proposal": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "testOnly": {"type": "boolean"},
        "requirementChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^(?:AC|INV)\\d{4}$"},
              "renumberedFrom": {"type": "string", "pattern": "^(?:AC|INV)\\d{4}$"},
              "status": {"enum": ["active", "accepted", "withdrawn", "superseded"]},
              "statement": {"type": "string", "pattern": "\\S"},
              "scenarios": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["id", "status", "statement", "scenarios"],
            "additionalProperties": false
          }
        },
        "baseline": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
        "planSnapshot": {
          "type": "string",
          "pattern": "^\\.katatay/local/[^/]+/plans/\\d{8}T\\d{6}\\.\\d{3}Z_[\\w-]{43}\\.md$"
        }
      },
      "required": ["proposal", "testOnly", "requirementChanges", "baseline", "planSnapshot"],
      "additionalProperties": false
    }
  },
  "required": ["version", "seq", "ts", "prev", "event", "payload"],
  "additionalProperties": false,
  "if": {"properties": {"seq": {"const": 1}}},
  "then": {"required": ["branch"], "properties": {"prev": {"type": "null"}}},
  "else": {"properties": {"prev": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "branch": false}}
}
