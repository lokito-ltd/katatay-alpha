{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline-moved.schema.json",
  "title": "Written baseline_moved event, version 1",
  "type": "object",
  "properties": {
    "version": {"const": 1},
    "seq": {"type": "integer", "minimum": 1, "maximum": 9999},
    "ts": {"$ref": "verified.schema.json#/$defs/timestamp"},
    "prev": {"oneOf": [{"type": "null"}, {"$ref": "verified.schema.json#/$defs/fingerprint"}]},
    "branch": {"type": "string", "pattern": "\\S"},
    "event": {"const": "baseline_moved"},
    "payload": {
      "type": "object",
      "properties": {
        "from": {"$ref": "verified.schema.json#/$defs/commit"},
        "to": {"$ref": "verified.schema.json#/$defs/commit"}
      },
      "required": ["from", "to"],
      "additionalProperties": false
    }
  },
  "required": ["version", "seq", "ts", "prev", "event", "payload"],
  "additionalProperties": false,
  "if": {
    "properties": {"seq": {"const": 1}}
  },
  "then": {
    "required": ["branch"],
    "properties": {"prev": {"type": "null"}}
  },
  "else": {
    "properties": {"prev": {"$ref": "verified.schema.json#/$defs/fingerprint"}, "branch": false}
  }
}
