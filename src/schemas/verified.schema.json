{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verified.schema.json",
  "title": "Written verified event, version 1",
  "type": "object",
  "properties": {
    "version": {"const": 1},
    "seq": {"type": "integer", "minimum": 1, "maximum": 9999},
    "ts": {"$ref": "#/$defs/timestamp"},
    "prev": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fingerprint"}]},
    "branch": {"type": "string", "pattern": "\\S"},
    "event": {"const": "verified"},
    "payload": {
      "type": "object",
      "properties": {
        "treeFingerprint": {"$ref": "#/$defs/fingerprint"},
        "implementationFingerprint": {"$ref": "#/$defs/fingerprint"},
        "testFingerprint": {"$ref": "#/$defs/fingerprint"},
        "rulebookFingerprint": {"$ref": "#/$defs/fingerprint"},
        "baseline": {"$ref": "#/$defs/commit"},
        "results": {
          "$ref": "#/$defs/results",
          "items": {"properties": {"status": {"not": {"const": "failed"}}}}
        },
        "trigger": {"const": "rerun"}
      },
      "required": ["treeFingerprint", "implementationFingerprint", "testFingerprint", "rulebookFingerprint", "baseline", "results"],
      "additionalProperties": false
    }
  },
  "required": ["version", "seq", "ts", "prev", "event", "payload"],
  "additionalProperties": false,
  "if": {"properties": {"seq": {"const": 1}}},
  "then": {"required": ["branch"], "properties": {"prev": {"type": "null"}}},
  "else": {"properties": {"prev": {"$ref": "#/$defs/fingerprint"}, "branch": false}},
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "text": {"type": "string", "pattern": "\\S"},
    "description": {"type": "string", "pattern": "^[^\\r\\n\\u2028\\u2029]*\\S[^\\r\\n\\u2028\\u2029]*$", "maxLength": 256},
    "count": {"type": "integer", "minimum": 0},
    "percent": {"type": "number", "minimum": 0, "maximum": 100, "description": "Rounded down to one decimal place."},
    "evidence": {
      "type": "object",
      "properties": {
        "role": {"enum": ["raw", "analysis"]},
        "title": {"$ref": "#/$defs/description"},
        "snapshot": {"type": "string", "pattern": "^\\.katatay/local/[^/]+/(?:[^/]+/)+\\d{8}T\\d{6}\\.\\d{3}Z_[\\w-]{43}\\.\\w+$"}
      },
      "required": ["role", "title", "snapshot"],
      "additionalProperties": false
    },
    "diagnosticsOnly": {
      "type": "object",
      "properties": {"diagnostics": {"type": "string"}},
      "additionalProperties": false
    },
    "testsSummary": {
      "type": "object",
      "properties": {
        "total": {"$ref": "#/$defs/count"}, "passed": {"$ref": "#/$defs/count"}, "failed": {"$ref": "#/$defs/count"},
        "skipped": {"$ref": "#/$defs/count"}, "inverted": {"$ref": "#/$defs/count"}, "omittedFiles": {"$ref": "#/$defs/count"},
        "diagnostics": {"type": "string"}
      },
      "required": ["total", "passed", "failed", "skipped", "inverted", "omittedFiles"],
      "additionalProperties": false
    },
    "coverageSummary": {
      "type": "object",
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "folder": {"$ref": "#/$defs/text"},
              "lines": {"$ref": "#/$defs/metric"},
              "branches": {"$ref": "#/$defs/metric"}
            },
            "required": ["folder", "lines", "branches"],
            "additionalProperties": false
          }
        },
        "diagnostics": {"type": "string"}
      },
      "required": ["folders"],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {"percent": {"$ref": "#/$defs/percent"}, "target": {"$ref": "#/$defs/percent"}},
      "required": ["percent", "target"],
      "additionalProperties": false
    },
    "mutationSummary": {
      "type": "object",
      "properties": {
        "totalMutants": {"$ref": "#/$defs/count"}, "killed": {"$ref": "#/$defs/count"}, "survived": {"$ref": "#/$defs/count"},
        "unproved": {"$ref": "#/$defs/count"}, "ignored": {"$ref": "#/$defs/count"}, "errored": {"$ref": "#/$defs/count"},
        "diagnostics": {"type": "string"}
      },
      "required": ["totalMutants", "killed", "survived", "unproved", "ignored", "errored"],
      "additionalProperties": false
    },
    "checkSummary": {
      "type": "object",
      "properties": {
        "outcome": {"enum": ["clean", "findings", "broken", "skipped"]},
        "exitCode": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 255}]},
        "limitations": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "diagnostics": {"type": "string"}
      },
      "required": ["outcome"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "status": {"enum": ["ok", "partial", "failed", "skipped", "reused"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "summary": {"type": "object"},
        "reason": {"$ref": "#/$defs/description"},
        "source": {
          "type": "object",
          "properties": {"seq": {"type": "integer", "minimum": 1}, "fingerprint": {"$ref": "#/$defs/fingerprint"}},
          "required": ["seq", "fingerprint"],
          "additionalProperties": false
        }
      },
      "required": ["name", "status", "evidence", "summary"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "reused"}}},
          "then": {"required": ["source"]},
          "else": {"properties": {"source": false}}
        },
        {
          "if": {"properties": {"status": {"enum": ["partial", "failed", "skipped", "reused"]}}},
          "then": {"required": ["reason"]}
        },
        {
          "if": {"properties": {"status": {"const": "skipped"}}},
          "then": {"properties": {"evidence": {"maxItems": 0}, "summary": {"maxProperties": 0}}}
        },
        {
          "if": {"properties": {"status": {"const": "partial"}}},
          "then": {"properties": {"name": {"enum": ["tests", "mutation"]}}}
        },
        {
          "if": {"properties": {"name": {"const": "tests"}, "status": {"enum": ["ok", "partial", "reused"]}}},
          "then": {"properties": {"summary": {"$ref": "#/$defs/testsSummary"}}}
        },
        {
          "if": {"properties": {"name": {"const": "coverage"}, "status": {"enum": ["ok", "reused"]}}},
          "then": {"properties": {"summary": {"$ref": "#/$defs/coverageSummary"}}}
        },
        {
          "if": {"properties": {"name": {"const": "mutation"}, "status": {"enum": ["ok", "partial", "reused"]}}},
          "then": {"properties": {"summary": {"$ref": "#/$defs/mutationSummary"}}}
        },
        {
          "if": {"properties": {"name": {"not": {"enum": ["tests", "coverage", "mutation"]}}, "status": {"enum": ["ok", "reused"]}}},
          "then": {"properties": {"summary": {"$ref": "#/$defs/checkSummary"}}}
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {"properties": {"summary": {"anyOf": [
            {"$ref": "#/$defs/diagnosticsOnly"}, {"$ref": "#/$defs/testsSummary"}, {"$ref": "#/$defs/coverageSummary"},
            {"$ref": "#/$defs/mutationSummary"}, {"$ref": "#/$defs/checkSummary"}
          ]}}}
        }
      ]
    },
    "results": {
      "description": "Every step and check in the order verify ran them. tests, coverage and mutation are always present, in that order among themselves, and names are unique.",
      "type": "array",
      "items": {"$ref": "#/$defs/result"},
      "allOf": [
        {"contains": {"properties": {"name": {"const": "tests"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "coverage"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "mutation"}}}, "minContains": 1, "maxContains": 1}
      ]
    }
  }
}
