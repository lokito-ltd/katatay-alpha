{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checks-analysis.schema.json",
  "title": "Written checks_analysis event, version 1",
  "type": "object",
  "properties": {
    "version": {"const": 1},
    "seq": {"type": "integer", "minimum": 1, "maximum": 9999},
    "ts": {"$ref": "verified.schema.json#/$defs/timestamp"},
    "prev": {"oneOf": [{"type": "null"}, {"$ref": "verified.schema.json#/$defs/fingerprint"}]},
    "branch": {"type": "string", "pattern": "\\S"},
    "event": {"const": "checks_analysis"},
    "payload": {
      "type": "object",
      "properties": {
        "verification": {"type": "integer", "minimum": 1, "description": "The seq of the verified event the analysis answers."},
        "summary": {"type": "string", "pattern": "\\S", "maxLength": 2000},
        "analysisSnapshot": {"type": "string", "pattern": "^\\.katatay/local/[^/]+/checks-analysis/\\d{8}T\\d{6}\\.\\d{3}Z_[\\w-]{43}\\.txt$"}
      },
      "required": ["verification", "summary", "analysisSnapshot"],
      "additionalProperties": false
    }
  },
  "required": ["version", "seq", "ts", "prev", "event", "payload"],
  "additionalProperties": false,
  "if": {"properties": {"seq": {"const": 1}}},
  "then": {"required": ["branch"], "properties": {"prev": {"type": "null"}}},
  "else": {"properties": {"prev": {"$ref": "verified.schema.json#/$defs/fingerprint"}, "branch": false}}
}
